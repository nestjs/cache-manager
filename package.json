{
  "name": "@nestjs/cache-manager",
  "version": "3.1.2",
  "type": "module",
  "description": "Nest - modern, fast, powerful node.js web framework (@cache-manager)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/cache-manager#readme",
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"{lib,test}/**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run --config vitest.config.ts",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-angular": "21.2.2",
    "@keyv/redis": "5.1.6",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/testing": "11.2.1",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "husky": "9.1.7",
    "keyv": "5.6.0",
    "lint-staged": "17.3.0",
    "oxlint": "1.79.0",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "release-it": "21.0.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "cache-manager": ">=6",
    "keyv": ">=5",
    "rxjs": "^7.8.1"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/cache-manager"
  }
}
